#   filter(is_approved, status == "Completed", drug_type %in% c("Protein", "Antibody", "Antibody drug conjugate")) %>%
#   mutate(
#   known_drugs = case_when(is.na(drug_name) ~ "Unknown",
#                           TRUE ~ "Known drugs")
# )
known_drugs_subnet_RA_CD_unique_approved <-
known_drugs_subnet_RA_CD_unique_phase4 %>%
select(
gene,
drug_name,
drug_type,
indication_name,
indication_max_phase
) %>%
mutate(
drug_gene = paste(drug_name, gene, sep = "->"),
value = 1
) %>%
distinct() %>%
filter(
!str_detect(
indication_name,
regex("(neoplasm|cancer|carcinoma|leukemia)", ignore_case = TRUE)
)
)
known_drugs_subnet_RA_CD_unique_approved_mat = known_drugs_subnet_RA_CD_unique_approved %>%
select(drug_gene, indication_name, value) %>% unique() %>%
pivot_wider(names_from = "drug_gene", values_from = "value", values_fill = 0) %>%
tibble::column_to_rownames(var = "indication_name")
rownames(known_drugs_subnet_RA_CD_unique_approved_mat) = gsub(",", "\n", rownames(known_drugs_subnet_RA_CD_unique_approved_mat))
#known_drugs_subnet_RA_CD_unique = known_drugs_subnet_RA_CD_unique[,c(1,3,5,8)]
heat_m_drug = Heatmap(t(known_drugs_subnet_RA_CD_unique_approved_mat),
cluster_columns = T,
name = "Indication",
col = structure(c("grey80", "grey25"), names = c(0, 1)),
width = nrow(known_drugs_subnet_RA_CD_unique_approved_mat) * unit(18, "mm"),
height = ncol(known_drugs_subnet_RA_CD_unique_approved_mat) * unit(18, "mm"),
show_row_dend = F,
show_column_dend = F,
rect_gp = gpar(col = "white"),
row_dend_width = unit(3, "cm"),
row_dend_gp = gpar(lwd =3),
heatmap_legend_param = list(
title_gp = gpar(fontsize = 25, fontface = "bold"),
labels_gp = gpar(fontsize = 25),
at = c(0, 1),
labels = c("NO", "Yes"),
grid_width = unit(12, "mm"),
grid_height = unit(12, "mm"),
title_gap = unit(5, "mm"),
direction = "horizontal"),
row_names_gp = gpar(fontsize = 25),
row_names_side = "left",
column_names_gp = gpar(fontsize = 25),
column_title_gp = gpar(fontsize = 30, fontface = "bold"),
column_names_side = "top", column_title_side = "bottom",
column_title = "Approved drugs",
column_names_rot = 45
)
#heat_m = ggplotify::as.ggplot(heat_m)
draw(heat_m_drug, heatmap_legend_side = "bottom")
known_drugs_subnet_RA_CD_unique_approved_tripartite = known_drugs_subnet_RA_CD_unique_approved
known_drugs_subnet_RA_CD_unique_approved_tripartite$indication_name = str_replace(known_drugs_subnet_RA_CD_unique_approved_tripartite$indication_name, " Positive", "+") %>%
str_to_sentence()
create_tripartite_ggplot(
data = known_drugs_subnet_RA_CD_unique_approved_tripartite,
drug_col = "drug_name",
gene_col = "gene",
indication_col = "indication_name",
weight_col = "indication_max_phase",
color_by = "gene", gene_color = "Set1",
node_size = 4, label_size = 7.5,
text_size = 20,
pathwidth = 2,
text_face = "plain",
trial_dot_size = 20,
trial_dot_color = "grey50",
title = "Approved drug → Gene → Indication Colored by Drug"
)
