unique(known_drugs_subnet_RA_CD$clinical_precedence)
known_drugs_subnet_RA_CD_unique_phase4 <- unique(known_drugs_subnet_RA_CD[known_drugs_subnet_RA_CD$status=="Completed" & known_drugs_subnet_RA_CD$clinical_precedence=="Approved" & !known_drugs_subnet_RA_CD$indication_is_therapeutic_area, c(1,2,5,7,12:16,24,25,26)]) %>% na.omit()
