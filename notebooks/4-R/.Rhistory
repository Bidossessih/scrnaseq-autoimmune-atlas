barplot4netannot(data = known_drugs_ori_priori, X = "known_drugs", Y = "Count", label = TRUE, ylab = "Number of genes", name = "Drugged genes", key.size = 0.4,   colmap = vega_20[11:12])
known_drugs_ori_2_priori = known_drugs_subnet_RA_CD_unique_priori[known_drugs_subnet_RA_CD_unique_priori$known_drugs == "Known drugs",] %>%
unique() %>% dplyr::select(ClinicalTrialPhase) %>% na.omit() %>%
dplyr::group_by(ClinicalTrialPhase) %>%
dplyr::summarise(Count = n()) %>% dplyr::arrange(Count) %>%
dplyr::mutate(ClinicalTrialPhase = as.factor(ClinicalTrialPhase))
barplot4netannot(data = known_drugs_ori_2_priori, X = "ClinicalTrialPhase", Y = "Count", ylab = "Number of clinical trials", label = TRUE, name = "Clinical Trial\nPhase", key.size = 0.4, colmap = vega_20 )
